# Postgres connection string (Neon, Supabase, Vercel Postgres or local)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/melanated_online

# Long random string used to sign auth tokens — generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Public URL of the site (no trailing slash). Used for absolute links, sitemap and OG images.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional — when set, media uploads are stored in Vercel Blob instead of the local /media folder
# BLOB_READ_WRITE_TOKEN=

# Optional — secret for the on-demand revalidation endpoint (POST /api/revalidate)
# REVALIDATION_SECRET=

# Required in production — Vercel Cron sends it as a Bearer token to /api/payload-jobs/run,
# which publishes scheduled posts. Generate with: openssl rand -hex 32
# CRON_SECRET=

# Optional. Integration tests use their own database so they never touch the one the dev
# server shows. Defaults to DATABASE_URL with "_test" added to the name (created if missing).
# TEST_DATABASE_URL=
